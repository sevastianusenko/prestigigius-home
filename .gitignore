# оригиналы фото с объектов — 549 МБ, в репозиторий не кладём.
# в public/photos/ попадают только сжатые версии, которые реально используются на страницах.
assets/photos/
assets/_duplicate-docs/

# необработанные свежие фото с объектов (прямо с телефона) — ждут обработки/выбора,
# пока не привязаны ни к одной странице. Случайно попали в прод через git add -A 10.10.2026.
public/photos/new photo/

.vercel
.env*

# competitor reference copy (internal, never publish)
docs/reference/

# client photo originals (contain GPS) — never publish
client-photos/originals/
